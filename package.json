{
  "name": "fq2js",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "start": "bun games/fq2/fq2.ts",
    "debug": "bun games/fq2/fq2.ts --debug",
    "server": "bun games/fq2/server.ts",
    "edit": "bun games/fq2/tools/edit.ts",
    "generate": "bun games/fq2/tools/generate.ts",
    "view": "bun games/fq2/tools/view.ts",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "check": "tsc && eslint . && bun test"
  },
  "devDependencies": {
    "@fq2js/engine": "workspace:*",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/bun": "^1.4.4",
    "@types/nodemailer": "^8.0.2",
    "@types/ssh2": "^1.15.6",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "trustedDependencies": [],
  "patchedDependencies": {
    "ssh2@1.17.0": "patches/ssh2@1.17.0.patch"
  }
}
