# Settings for the multiplayer server (bun run server). Copy this file to
# .env in the folder you start the server from, and fill in what you need;
# Bun reads it when the server starts. Anything left out (or empty) takes
# its default. Options given on the command line win over these.

# Where to listen: 127.0.0.1 is this computer only; 0.0.0.0 lets others in.
FQ2_HOST=127.0.0.1
# Where the web page listens, if not FQ2_HOST: 127.0.0.1 behind a TLS proxy
# (see docs/deploying.md), while telnet and SSH listen to everyone.
FQ2_WEB_HOST=
FQ2_TELNET_PORT=2323
FQ2_WEB_PORT=8080
# SSH: any user name, no password, then the game's login screen.
FQ2_SSH_PORT=2222
# true turns that way of connecting off (telnet sends passwords unencrypted).
FQ2_NO_TELNET=false
FQ2_NO_WEB=false
FQ2_NO_SSH=false
# Where the database and the SSH host key go.
FQ2_DATA=server-data
# The mods to add to the game, a folder each (default: mods, if there is one).
FQ2_MODS=
FQ2_MAX_PLAYERS=50
FQ2_IDLE_MINUTES=30

# The mail server that sends players' codes (confirming their email address,
# resetting their password). Without a host, emails go to the server's log.
FQ2_SMTP_HOST=
# 587 (STARTTLS) or 465 (TLS from the start).
FQ2_SMTP_PORT=587
FQ2_SMTP_USER=
FQ2_SMTP_PASSWORD=
# Who the emails are from (default: FQ2_SMTP_USER), e.g.
# Final Quest 2 <game@example.com>
FQ2_MAIL_FROM=

# Game rules (whole numbers; empty for the default, shown).
# Fights each player can start against others a day.
FQ2_FIGHTS_PER_DAY=3
# How much of the loser's gold the winner takes, and of their experience the
# winner gets, in percent.
FQ2_PVP_GOLD_PERCENT=50
FQ2_PVP_EXP_PERCENT=10
# How long before a player can talk (T, Y) again.
FQ2_CHAT_WAIT_SECONDS=1
# Letters a player can send each visit, and how many each mailbox keeps.
FQ2_LETTERS_PER_VISIT=10
FQ2_MAILBOX=50
# Days the news is kept.
FQ2_NEWS_DAYS=7
# Emails (codes) a connection can ask for.
FQ2_EMAILS_PER_VISIT=5
